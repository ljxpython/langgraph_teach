# 🚀 LangGraph SDK 环境配置
# 复制此文件为 .env 并填入你的实际配置

# LangGraph 服务器配置
LANGGRAPH_URL=http://localhost:8123
LANGGRAPH_API_KEY=  # 如果需要认证，填入你的API密钥
LANGGRAPH_ASSISTANT_ID=agent_not_deep

# 助手配置 (可选)
DEFAULT_ASSISTANT_ID=agent_not_deep

# 项目配置
PROJECT_NAME=LangGraph SDK 学习项目
DEBUG=true

# 超时配置 (秒)
CONNECTION_TIMEOUT=30
REQUEST_TIMEOUT=60
STREAM_TIMEOUT=120

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 开发配置
DEV_MODE=true
VERIFY_SSL=true

# 批量处理配置
MAX_CONCURRENT_TASKS=3
BATCH_SIZE=5

# 流式处理配置
DEFAULT_STREAM_MODE=updates
STREAM_CHUNK_SIZE=1024